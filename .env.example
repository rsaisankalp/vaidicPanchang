# Copy to .env.local and fill in. Do not commit .env.local.

# When set, the panchang API endpoints proxy back to the original
# gwala.krishnayangauraksha.org service (used to verify our TS implementation).
# Leave empty in production to use the in-process TypeScript implementation.
PANCHANG_API_URL=

# vds_seva PostgreSQL — provides the wa_events and pincode_geo tables.
# On the deploy host this is a localhost connection.
SEVA_DATABASE_URL=postgresql://marketing_user:CHANGE_ME@127.0.0.1:5432/vds_seva

# Comma-separated Gemini API keys. The backfill rotates randomly through them
# to avoid rate-limit on a single key. Same keys used by marketing.vaidicpujas.in.
GOOGLE_API_KEYS=

# Public origin used by the frontend when building absolute URLs.
NEXT_PUBLIC_BASE_URL=https://panchang.vaidicpujas.in
